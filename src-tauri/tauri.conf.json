{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eavesdrop",
  "version": "0.1.15",
  "identifier": "com.eavesdrop.recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Eavesdrop",
        "url": "/",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "quick_panel",
        "title": "Eavesdrop recorder",
        "url": "/?surface=quick",
        "width": 360,
        "height": 410,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/eavesdrop-summarizer"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Private meeting recording from your microphone and computer.",
    "longDescription": "A tray-first meeting recorder with encrypted local storage.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDMTM2NTQyRTFGMTMyQTQKUldTa012SGhRbVVUWENyQk1oQUdNM2hQTk8vVFh3SDkxRnJrVklKVDdlOFJ2d3drdStjV0x2VGYK",
      "endpoints": [
        "https://github.com/Oak-Digital/eavesdrop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
